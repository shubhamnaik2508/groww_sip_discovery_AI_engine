# --- AI inference (server-side only; never exposed to the browser) ---
# Selection order: AI_PROVIDER (if that provider has a key) → Gemini → Groq.
# Gemini is the default whenever GEMINI_API_KEY is set.
GEMINI_API_KEY=""
# Optional: override the Gemini model (default gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# Groq: fallback provider (OpenAI-compatible API).
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"

# Force a provider: "gemini" | "groq" | "fake" (fake = simulated test double, excluded from research counts)
# AI_PROVIDER="gemini"

# --- Access control for paid AI runs and data changes ---
# Required on production deployments: without it, live AI runs, imports and
# validation submissions are disabled there. Share it only with reviewers.
RESEARCH_ADMIN_PASSCODE=""

# --- Database (optional) ---
# Local default: file:groww_sip_lab.db. On Vercel the default is ephemeral /tmp;
# bundled datasets reload on every cold start. For durable UI imports/reviews use Turso.
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
