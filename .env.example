# --- AI inference (server-side only; never sent to the browser) ---
# Gemini is preferred whenever its key is set; Groq is the alternative.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# AI_PROVIDER="gemini" | "groq" | "fake"   (fake = simulated test double, excluded from research counts)

# --- Public live-AI demo (Vercel) ---
# The public site is open to everyone (no login, no passcode). Official data changes and
# saved AI runs are refused server-side on every Vercel deployment; visitors can only use
# the live demo, whose results are never saved.
# The demo runs only when BOTH are true:
#   1. AI_DEMO_ENABLED="true"
#   2. A shared Upstash Redis store is connected (Vercel → Storage → Upstash Redis).
#      Vercel then adds KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# Without Redis the demo stays off: limits are never kept in server memory.
AI_DEMO_ENABLED="false"
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# Optional limits (defaults shown). Instant kill switch: set Redis key demo:disabled = 1.
# AI_DEMO_DAILY_CALLS="60"
# AI_DEMO_DAILY_TOKENS="400000"
# AI_DEMO_VISITOR_HOURLY_CALLS="6"
# AI_DEMO_VISITOR_DAILY_CALLS="12"
# AI_DEMO_SALT="any-random-string"   (salts the hashed visitor id)

# --- Database (optional) ---
# Local default: file:groww_sip_lab.db. On Vercel the bundled research datasets load
# automatically on every deployment (read-only public copy).
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
